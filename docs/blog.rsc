ren":[["$","aside",null,{"className":"_storyAside_ymy3c_171","aria-label":"Article summary","children":[["$","span",null,{"className":"_storyNumber_ymy3c_172","children":"01"}],["$","p",null,{"lang":"ml","children":["കൂട്ടായ്മയുടെ",["$","br",null,{}],"പുതിയ ചുവട്"]}]]}],["$","div",null,{"className":"_storyBody_ymy3c_185","lang":"ml","children":[["$","p",null,{"className":"_lede_ymy3c_187","children":"വൈറ്റ്ഫീൽഡ് മലയാളി സോഷ്യൽ ക്ലബ്ബിൻ്റെ (WMSC) പ്രവർത്തക സമിതി യോഗം സംഘടിപ്പിച്ചു. വരാനിരിക്കുന്ന ഓണാഘോഷ പരിപാടികളുമായി ബന്ധപ്പെട്ട ഒരുക്കങ്ങളും വിവിധ പരിപാടികളുടെ നടത്തിപ്പും യോഗത്തിൽ വിശദമായി ചർച്ച ചെയ്തു."}],["$","p",null,{"children":"വൈറ്റ്ഫീൽഡ് മലയാളി സോഷ്യൽ ക്ലബ് പ്രവർത്തക സമിതി അംഗങ്ങൾക്കൊപ്പം ക്ലബ് അംഗങ്ങളും കുടുംബാംഗങ്ങളും യോഗത്തിൽ പങ്കെടുത്തു. ഓണാഘോഷം കൂടുതൽ വിപുലമായും എല്ലാവരെയും ഉൾക്കൊള്ളുന്ന രീതിയിലും സംഘടിപ്പിക്കുന്നതിനായുള്ള വിവിധ നിർദ്ദേശങ്ങളും ആശയങ്ങളും യോഗത്തിൽ പങ്കുവെച്ചു."}],["$","p",null,{"children":"അംഗങ്ങളുടെയും കുടുംബങ്ങളുടെയും സജീവ പങ്കാളിത്തം യോഗത്തിന് കൂടുതൽ ആവേശവും കൂട്ടായ്മയും പകർന്നു. ഓണത്തിൻ്റെ സ്നേഹവും സൗഹൃദവും മലയാളി കൂട്ടായ്മയുടെ ഐക്യവും ഉയർത്തിപ്പിടിക്കുന്ന മികച്ചൊരു ആഘോഷത്തിനായുള്ള ഒരുക്കങ്ങൾക്ക് യോഗം തുടക്കം കുറിച്ചു."}]]}]]}]]}],["$","section",null,{"className":"_communityNote_ymy3c_211","aria-label":"Join WMSC","children":[["$","p",null,{"lang":"ml","children":"കൂടെ കൂടാം"}],["$","div",null,{"children":[["$","h2",null,{"children":"Community begins by showing up."}],["$","a",null,{"href":"https://forms.gle/ajbEX18S3ryEoFgC8?utm_source=wmsc.in","target":"_blank","rel":"noreferrer","children":["Join WMSC ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}],["$","footer",null,{"className":"_footer_ymy3c_229","children":[["$","div",null,{"className":"_footerBrand_ymy3c_238","children":[["$","img",null,{"src":"/logo.png","alt":"WMSC emblem"}],["$","div",null,{"children":[["$","strong",null,{"children":"WMSC"}],["$","p",null,{"children":["Whitefield Malayali",["$","br",null,{}],"Social Club"]}]]}]]}],["$","p",null,{"children":["Kerala in our hearts.",["$","br",null,{}],"Whitefield at our doorstep."]}],["$","div",null,{"className":"_footerLinks_ymy3c_243","children":[["$","a",null,{"href":"/","children":"Home"}],["$","a",null,{"href":"/onam/","children":"Onam 1.0"}],["$","a",null,{"href":"#top","children":"Back to top ↑"}]]}]]}]]}]]
