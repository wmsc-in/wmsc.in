":[["$","p",null,{"children":[["$","span",null,{"children":"Published"}],["$","time",null,{"dateTime":"2026-09-04","children":"04 September 2026"}]]}],["$","p",null,{"children":[["$","span",null,{"children":"Location"}],"Whitefield, Bengaluru"]}]]}]]}],["$","p",null,{"className":"_heroMark_1u52f_125","aria-hidden":"true","children":"ഒരുമ"}]]}],["$","figure",null,{"className":"_leadImage_1u52f_137","children":[["$","img",null,{"src":"/wmsc-executive-committee-meeting.jpg","alt":"WMSC executive committee members, club members and their families at the meeting","width":"872","height":"547"}],["$","figcaption",null,{"children":[["$","span",null,{"children":"WMSC executive committee meeting"}],["$","span",null,{"children":"Whitefield · Bengaluru"}]]}]]}],["$","div",null,{"className":"_storyGrid_1u52f_159","children":[["$","aside",null,{"className":"_storyAside_1u52f_169","aria-label":"Article summary","children":[["$","span",null,{"className":"_storyNumber_1u52f_170","children":"01"}],["$","p",null,{"lang":"ml","children":["കൂട്ടായ്മയുടെ",["$","br",null,{}],"പുതിയ ചുവട്"]}]]}],["$","div",null,{"className":"_storyBody_1u52f_183","lang":"ml","children":[["$","p",null,{"className":"_lede_1u52f_185","children":"വൈറ്റ്ഫീൽഡ് മലയാളി സോഷ്യൽ ക്ലബ്ബിൻ്റെ (WMSC) പ്രവർത്തക സമിതി യോഗം സംഘടിപ്പിച്ചു. വരാനിരിക്കുന്ന ഓണാഘോഷ പരിപാടികളുമായി ബന്ധപ്പെട്ട ഒരുക്കങ്ങളും വിവിധ പരിപാടികളുടെ നടത്തിപ്പും യോഗത്തിൽ വിശദമായി ചർച്ച ചെയ്തു."}],["$","p",null,{"children":"വൈറ്റ്ഫീൽഡ് മലയാളി സോഷ്യൽ ക്ലബ് പ്രവർത്തക സമിതി അംഗങ്ങൾക്കൊപ്പം ക്ലബ് അംഗങ്ങളും കുടുംബാംഗങ്ങളും യോഗത്തിൽ പങ്കെടുത്തു. ഓണാഘോഷം കൂടുതൽ വിപുലമായും എല്ലാവരെയും ഉൾക്കൊള്ളുന്ന രീതിയിലും സംഘടിപ്പിക്കുന്നതിനായുള്ള വിവിധ നിർദ്ദേശങ്ങളും ആശയങ്ങളും യോഗത്തിൽ പങ്കുവെച്ചു."}],["$","p",null,{"children":"അംഗങ്ങളുടെയും കുടുംബങ്ങളുടെയും സജീവ പങ്കാളിത്തം യോഗത്തിന് കൂടുതൽ ആവേശവും കൂട്ടായ്മയും പകർന്നു. ഓണത്തിൻ്റെ സ്നേഹവും സൗഹൃദവും മലയാളി കൂട്ടായ്മയുടെ ഐക്യവും ഉയർത്തിപ്പിടിക്കുന്ന മികച്ചൊരു ആഘോഷത്തിനായുള്ള ഒരുക്കങ്ങൾക്ക് യോഗം തുടക്കം കുറിച്ചു."}],["$","div",null,{"className":"_sourceNote_1u52f_193","children":[["$","span",null,{"children":"Source"}],["$","p",null,{"children":["Originally published by Bangalore Jalakam."," ",["$","a",null,{"href":"https://bangalorejalakam.com/the-whitefield-malayali-social-club-organized-an-executive-committee-meeting/","target":"_blank","rel":"noreferrer","children":["Read the original article ","$La"]}]]}]]}]]}]]}]]}],"$Lb","$Lc"]}]]
